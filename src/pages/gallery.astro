---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
const AllPhotos = import.meta.glob('../../public/Photos/*.{jpg,jpeg,JPG,JPEG}', {eager:true});
const Photos = (Object.values(AllPhotos) as {default: ImageMetadata}[]).reverse();
---

<Layout title=Gallery>
    <h1 class="title fadeIn delay-2">Gallery</h1>
    <p class="gallery-phase fadeIn delay-3">A collection of snapshot memories, street aesthetics, and quiet milestones.</p>
    <div class="gallery-board fadeIn delay-4">
        {
            Photos.map((photo) => (
                <img class="photo-box" src={photo.default.src} alt="">
            ))
        }
    </div>
</Layout>

<style>
    .gallery-phase{
    font-family: monospace;
    }

    .gallery-board{
    display: grid;
    grid-template-columns: repeat(5,1fr);
    gap: 4px;
    margin-top: 40px;
    }

    .gallery-board a{
    padding: 0;
    }

    .photo-box{
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1/1;
    filter: grayscale(100%);
    transition: transform 0.4s ease, filter 0.4s ease;
    }

    .photo-box:hover{
    filter: grayscale(0%);
    transform: scale(1.03);
    }
</style>