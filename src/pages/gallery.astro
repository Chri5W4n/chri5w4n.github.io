---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
const AllPhotos = import.meta.glob<{ default: ImageMetadata }>('../Photos/*.{jpg,jpeg,JPG,JPEG}');
const Photos = Object.keys(AllPhotos).reverse();
---

<Layout title=Gallery>
    <h1 class="title fadeIn delay-2">Gallery</h1>
    <p class="gallery-phase fadeIn delay-3">A collection of snapshot memories, street aesthetics, and quiet milestones.</p>
    <div class="gallery-board fadeIn delay-4">
        {
            Photos.map((photo) => (
                <Image
                    class="photo-box"
                    src={AllPhotos[photo]()}
                    alt="Gallery snapshot" 
                    width={600}  
                    height={600} 
                    loading="eager"
                />
            ))
        }
    </div>
</Layout>

<style>
    .gallery-phase{
    font-family: monospace;
    }

    .gallery-board{
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 4px;
    margin-top: 40px;
    }
    @media (min-width: 768px) {
        .gallery-board {
            grid-template-columns: repeat(5, 1fr);
        }
    }

    .gallery-board a{
    padding: 0;
    }

    .photo-box{
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1/1;
    filter: grayscale(100%);
    transition: transform 0.4s ease, filter 0.4s ease;
    }

    .photo-box:hover{
    filter: grayscale(0%);
    transform: scale(1.03);
    }
</style>