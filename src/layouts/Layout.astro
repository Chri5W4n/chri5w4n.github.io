---
const { title } = Astro.props;
import '@fontsource/playfair-display/700.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="preload" href="/_astro/playfair-display-latin-700-normal.CuDiGg7c.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ title }</title>
  </head>
  <body>

    <header class="fadeIn delay-1">
      <nav>
        <a href="/" class:list={["nav-now", { active: Astro.url.pathname === "/" }]}>Now</a>
        <a href="/blog" class:list={["nav-blog", { active: Astro.url.pathname.includes("blog") }]}>Blog</a>
        <a href="/project" class:list={["nav-project", { active: Astro.url.pathname.includes("project") }]}>Project</a>
        <a href="/gallery" class:list={["nav-gallery", { active: Astro.url.pathname.includes("gallery") }]}>Gallery</a>
        <a href="/me" class:list={["nav-me", { active: Astro.url.pathname.includes("me") }]}>Me</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="fadeIn delay-5">
        <div class="footer-links">
          <a href="https://github.com/Chri5W4n" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="#" class="anti-bot-email" onclick="const u='me', d='chri5w4n.com'; this.href='mail'+'to:'+u+'@'+d;">moc.n4w5irhc@em</a>
        </div>
        <p class="copyright">&copy; 2026 Chri5W4n</p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin:0;
    padding:0;
    color: #cbcbcb;
    background-color: #1b1b1c;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  /* header&nav */

  header{
    display: flex;
    justify-content: flex-end;
    padding: 20px 40px;
  }

  nav{
    display: flex;
    gap: 16px;
  }

  a{
    position: relative;
    color:inherit;
    font-size: 0.95rem;
    text-decoration: none;
    display: inline-block;
    padding: 8px;
    transition: color 0.2s;
  }

  nav a.active{
    pointer-events: none;
  }

  nav a::after{
    content: "";
    position: absolute;
    bottom: 0;
    left: 8px;
    width: 0px;
    height: 1.2px;
    background-color: #b58863;
    transition: width 0.3s ease;
  }

  nav a:hover::after, nav a.active::after{
    width: calc(100% - 16px);
  }

  a:hover{
    color:#ffffff;
  }

  /* main */

  main{
    flex: 1;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 0px 24px 80px;
  }

  .title{
    font-family: "Playfair Display", serif;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .section-header{
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .subtitle {
    color: #fff;
    font-family: serif;
    font-size:1.2rem;
    font-weight: 500;
  }

  .date {
    color: #555 !important;
    font-family: serif;
    font-size: 0.85rem !important;
    margin-bottom: 0px !important;
  }

  /* footer */

  footer{
    font-family: serif;
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 8px 24px 16px;
    border-top: 1px solid #2b2b2c;
  }

  .footer-links{
    display: flex;
    align-items: center;
    gap: 24px;
  }

  footer a{
    color: #777777;
    font-size: 0.8rem;
    padding: 0;
  }

  footer a:hover{
    color: #ffffff;
  }

  .copyright{
    color: #444444;
    font-size: 0.8rem;
  }

  @keyframes loadingAnima{
    0%{
      opacity: 0;
      transform: translateY(8px);
    }
    100%{
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fadeIn{
    opacity: 0;
    animation: loadingAnima 4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-1 { animation-delay: 150ms; }
  .delay-2 { animation-delay: 350ms; }
  .delay-3 { animation-delay: 550ms; }
  .delay-4 { animation-delay: 750ms; }
  .delay-5 { animation-delay: 950ms; }
  .delay-6 { animation-delay: 1450ms; }
  
  .anti-bot-email {
    direction: rtl;
    unicode-bidi: bidi-override;
  }
</style>